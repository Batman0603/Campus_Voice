generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  SEN
  HOD
  COORDINATOR
  PRINCIPAL
  ADMIN
}

model Department {
  id             String          @id @default(cuid())
  name           String          @unique
  code           String          @unique
  users          User[]
  questionnaires Questionnaire[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("departments")
}

model User {
  id                    String                    @id @default(cuid())
  name                  String
  email                 String                    @unique
  passwordHash          String
  role                  Role                      @default(STUDENT)
  departmentId          String?
  department            Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdQuestionnaires Questionnaire[]
  receivedAssignments   QuestionnaireAssignment[] @relation("AssignmentRecipient")
  issuedAssignments     QuestionnaireAssignment[] @relation("AssignmentIssuer")
  isActive              Boolean                   @default(true)
  sessionVersion        Int                       @default(0)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([role])
  @@index([departmentId])
  @@map("users")
}

// Preserve the existing foundation model.
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

enum QuestionnairePurpose {
  STUDENT_VOICE
  TEACHER_REFLECTION
  SEN
  HOD_CHECK
  LEADERSHIP_REPORT
}

enum QuestionnaireStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING
  YES_NO
}

model Questionnaire {
  id          String               @id @default(cuid())
  title       String
  description String?
  purpose     QuestionnairePurpose
  status      QuestionnaireStatus  @default(DRAFT)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  sections    QuestionnaireSection[]
  assignments QuestionnaireAssignment[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdById])
  @@index([departmentId, status])
  @@index([purpose, status])
  @@map("questionnaires")
}

model QuestionnaireSection {
  id              String        @id @default(cuid())
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  title       String
  description String?
  position    Int
  questions   Question[]

  @@unique([questionnaireId, position])
  @@map("questionnaire_sections")
}

model Question {
  id        String               @id @default(cuid())
  sectionId String
  section   QuestionnaireSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  title             String
  type              QuestionType
  required          Boolean            @default(false)
  position          Int
  options           QuestionOption[]
  submissionAnswers SubmissionAnswer[]

  @@unique([sectionId, position])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  label               String
  value               String
  position            Int
  nextSectionPosition Int?

  @@unique([questionId, position])
  @@unique([questionId, value])
  @@map("question_options")
}

model QuestionnaireAssignment {
  id String @id @default(cuid())

  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation("AssignmentRecipient", fields: [userId], references: [id], onDelete: Restrict)

  assignedById String
  assignedBy   User   @relation("AssignmentIssuer", fields: [assignedById], references: [id], onDelete: Restrict)

  submission FeedbackSubmission?
  assignedAt DateTime            @default(now())

  @@unique([questionnaireId, userId])
  @@index([userId])
  @@map("questionnaire_assignments")
}

model FeedbackSubmission {
  id String @id @default(cuid())

  assignmentId String                  @unique
  assignment   QuestionnaireAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  answers     SubmissionAnswer[]
  submittedAt DateTime           @default(now())

  @@map("feedback_submissions")
}

model SubmissionAnswer {
  id String @id @default(cuid())

  submissionId String
  submission   FeedbackSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  value Json

  @@unique([submissionId, questionId])
  @@index([questionId])
  @@map("submission_answers")
}
